  "info": {
    "name": "ms-risk-engine - Simulation Draft API",
    "description": "Postman collection for testing the SimulationDraft API endpoint of ms-risk-engine microservice. This collection includes requests for generating simulation drafts with various product types (Loan, Mortgage, Credit Card) and different form change scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "ms-risk-engine-2026"
  },
  "item": [
    {
      "name": "Simulation Draft - LOAN",
      "item": [
        {
          "name": "Calculate Draft - LOAN (Basic)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate a unique requestId using timestamp and random number",
                  "const timestamp = new Date().getTime();",
                  "const random = Math.floor(Math.random() * 10000);",
                  "pm.environment.set('requestId', `REQ-LOAN-${timestamp}-${random}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Verify response status is 200",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Verify response structure",
                  "pm.test('Response contains required fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('requestId');",
                  "    pm.expect(jsonData).to.have.property('partyId');",
                  "    pm.expect(jsonData).to.have.property('baseScoringId');",
                  "    pm.expect(jsonData).to.have.property('formChanges');",
                  "    pm.expect(jsonData).to.have.property('simulatedResults');",
                  "    pm.expect(jsonData).to.have.property('delta');",
                  "});",
                  "",
                  "// Verify simulatedResults structure",
                  "pm.test('SimulatedResults contains risk metrics', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.simulatedResults).to.have.property('probabilityOfDefault');",
                  "    pm.expect(jsonData.simulatedResults).to.have.property('exposureAtDefault');",
                  "    pm.expect(jsonData.simulatedResults).to.have.property('lossGivenDefault');",
                  "    pm.expect(jsonData.simulatedResults).to.have.property('expectedCreditLoss');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"requestType\": \"LOAN\",\n  \"formChanges\": {\n    \"interestRate\": 5.5,\n    \"termMonths\": 60,\n    \"requestedAmount\": 25000,\n    \"annualIncome\": 50000,\n    \"employmentStatus\": \"EMPLOYED\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/simulations/draft",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "simulations",
                "draft"
              ]
            },
            "description": "Calculate simulation draft for a LOAN with basic parameters including interest rate, term, amount, income, and employment status."
          },
          "response": []
        },
